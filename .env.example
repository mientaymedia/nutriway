# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# File này chỉ chứa giá trị giả hoặc để trống.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự để ký phiên quản trị (tạo bằng: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# PostgreSQL
DATABASE_URL=postgres://nutriway:doi-mat-khau@localhost:5432/nutriway

# AccessTrade. API key lấy tại https://pub2.accesstrade.vn/profile/api_key
# pub_id là định danh công khai, an toàn khi nằm trong link affiliate.
ACCESSTRADE_API_KEY=
ACCESSTRADE_PUB_ID=6236317561687671934

# MoMo. TEST và PRODUCTION là HAI BỘ GIÁ TRỊ KHÁC NHAU (mã đối tác và endpoint).
# Phát triển: dùng khoá TEST với endpoint test (mặc định bên dưới).
# Production: đặt trực tiếp trên máy chủ, không ghi vào file nào trong repo.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# SePay (VietQR). Bật khi đã cấu hình webhook.
SEPAY_ENABLED=false
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

# Hoá đơn điện tử P.A Việt Nam. Cập nhật khi có tài liệu API.
PA_INVOICE_ENABLED=false
PA_INVOICE_BASE_URL=
PA_INVOICE_API_KEY=
